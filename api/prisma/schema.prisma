datasource db {
  provider = "postgresql"
  url      = env("DATABASE_PRISMA_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String?
  password        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  linkedProviders LinkedProvider[]
}

model LinkedProvider {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  providerId String
  linkedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@unique([userId, provider])
}

model WeddingSettings {
  id                        String    @id @default(uuid())
  coupleNameA               String    @default("Caleb")
  coupleNameB               String    @default("Raissa")
  weddingDate               DateTime?
  rsvpDeadline              DateTime?
  siteTitle                 String?
  siteDescription           String?
  heroImageUrl              String?
  heroImageOffsetX          Int?
  heroImageOffsetY          Int?
  heroImageHeight           Int?
  monogramUrl               String?
  rsvpTagline               String?
  rsvpSubtext               String?
  themeBackground           String?
  themeForeground           String?
  themeMuted                String?
  themeAccent               String?
  themeBorder               String?
  themeSurface              String?
  themeInverseBackground    String?
  themeOverlayText          String?
  themeOverlayScrim         String?
  welcomeMessage            String?
  inviteSubject             String?
  inviteHeading             String?
  inviteTagline             String?
  inviteGreeting            String?
  inviteMessage             String?
  inviteButtonText          String?
  inviteSignoff             String?
  inviteBackgroundColor     String?
  inviteTextColor           String?
  inviteAccentColor         String?
  inviteMutedColor          String?
  inviteButtonTextColor     String?
  isPublic                  Boolean   @default(true)
  isRsvpEnabled             Boolean   @default(true)
  allowMaybe                Boolean   @default(false)
  enableMealPreference      Boolean   @default(true)
  enableSongRequest         Boolean   @default(true)
  enableGuestbook           Boolean   @default(false)
  requireUniqueTableNumbers Boolean   @default(false)
  requireUniqueTableNames   Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model Guest {
  id                    String   @id @default(uuid())
  primaryName           String
  email                 String?
  phone                 String?
  group                 String?
  allowedPartySize      Int      @default(1)
  plusOneAllowed        Boolean  @default(false)
  requiresMealSelection Boolean  @default(false)
  invitationCode        String   @unique
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  rsvp              Rsvp?
  seatingAssignment SeatingAssignment?
  galleryUploads    GalleryImage[]
}

model Rsvp {
  id                  String     @id @default(uuid())
  guestId             String     @unique
  guest               Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  status              RsvpStatus
  attendeeCount       Int        @default(0)
  plusOneName         String?
  email               String?
  phone               String?
  mealPreference      String?
  dietaryRestrictions String?
  message             String?
  songRequest         String?
  submittedAt         DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINED
  MAYBE
}

model WeddingEvent {
  id             String    @id @default(uuid())
  /// Deprecated: no longer read or written by the app. Kept so existing values are never lost (see CLAUDE.md).
  type           String?
  tagline        String?
  title          String
  venueName      String?
  address        String?
  startTime      DateTime?
  endTime        DateTime?
  mapUrl         String?
  notes          String?
  displayOrder   Int       @default(0)
  showOnHomepage Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ScheduleItem {
  id           String   @id @default(uuid())
  timeLabel    String
  title        String
  description  String?
  location     String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FaqItem {
  id           String   @id @default(uuid())
  question     String
  answer       String
  category     String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GalleryImage {
  id           String   @id @default(uuid())
  title        String?
  description  String?
  imageUrl     String
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  /// Set when a guest uploaded the photo themselves (shown as "Shared by <name>").
  /// Deleting the guest keeps the photo.
  guestId      String?
  guest        Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([guestId])
}

/// Guest photo uploads on the Gallery page (single row, created on first save).
model GallerySettings {
  id              String   @id @default(uuid())
  uploadsEnabled  Boolean  @default(true)
  /// When on, guest photos wait in the dashboard until an admin publishes them.
  requireApproval Boolean  @default(true)
  heading         String?
  subtext         String?
  buttonLabel     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StoryTimelineItem {
  id           String   @id @default(uuid())
  dateLabel    String?
  title        String
  description  String?
  imageUrl     String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactPerson {
  id           String   @id @default(uuid())
  name         String
  role         String?
  email        String?
  phone        String?
  notes        String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SeatingTable {
  id          String   @id @default(uuid())
  tableNumber Int?
  name        String?
  capacity    Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments SeatingAssignment[]
}

model SeatingAssignment {
  id        String       @id @default(uuid())
  guestId   String       @unique
  guest     Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tableId   String
  table     SeatingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  seatLabel String?
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

/// Single row (id "singleton"): editable header + call-to-action copy for the /details page.
/// Blank text fields fall back to defaults in src/details-page/details-page.defaults.ts.
model DetailsPage {
  id                String   @id @default(uuid())
  headerEyebrow     String?
  headerTitle       String?
  location          String?
  showAddToCalendar Boolean  @default(true)
  ctaEnabled        Boolean  @default(true)
  ctaHeading        String?
  ctaSubtext        String?
  ctaButtonLabel    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Single row (id "singleton"): Dress Code section settings on the /details page.
model DressCode {
  id        String   @id @default(uuid())
  enabled   Boolean  @default(false)
  eyebrow   String?
  title     String?
  intro     String?
  /// Hex colors shown as brush swatches, in display order.
  palette   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One guidance row in the Dress Code section, e.g. "For the Ladies".
model DressCodeGuideline {
  id           String   @id @default(uuid())
  label        String
  text         String
  note         String?
  /// Example outfit photos shown with this guideline, in display order.
  imageUrls    String[] @default([])
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
